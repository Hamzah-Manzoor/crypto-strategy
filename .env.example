# Template for .env (git-ignored). `python3 scripts/lab.py setup` copies this to .env
# and fills the empty FreqUI secrets with random values.
#
# NEVER put exchange API keys here (or anywhere in this repo).
# The safety check fails if any FREQTRADE__EXCHANGE__KEY / SECRET / PASSWORD is set.

# --- FreqUI / REST API login for the paper-trading bots (local only, 127.0.0.1) ---
FREQTRADE__API_SERVER__USERNAME=lab
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=

# --- Optional Telegram alerts (off by default) ---
# Put them in a per-bot file, .env.bot-<bot name> (git-ignored), NOT here: each paper bot
# needs its own Telegram bot token. Steps: docs/SETUP.md > Telegram alerts.
